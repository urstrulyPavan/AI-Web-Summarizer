{
  "manifest_version": 3,
  "name": "AI Web Summarizer",
  "version": "1.0",
  "description": "Lightweight page summarizer and context-aware quiz generator.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"]
    }
  ]
}